{
  "name": "beatchart-arcade",
  "version": "1.8.1",
  "description": "BeatChart Arcade — 本地离线自动谱面音游（导入音频 → 自动分析 → E/H/EX 三档谱面 → 游玩）",
  "main": "electron/main.js",
  "author": "TeleAgent",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite build && electron .",
    "build": "vite build",
    "start": "electron .",
    "test": "node tests/test-core.mjs",
    "dist": "vite build && node scripts/verify-dist.mjs && electron-builder --win portable --x64",
    "dist:dir": "vite build && node scripts/verify-dist.mjs && electron-builder --win portable --x64 --dir",
    "verify-dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@pixi/unsafe-eval": "^7.4.3",
    "pixi.js": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.teleagent.beatchart",
    "productName": "BeatChart Arcade",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BeatChartArcade-Portable-${version}.exe"
    },
    "portable": {
      "unpackDirName": "BeatChartArcade"
    }
  },
  "allowScripts": {}
}
